USE_MYSQL=1
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=hotel_bot
MYSQL_USER=hotel_bot
MYSQL_PASSWORD=cambia_esta_contrasena

# Opcional si usas socket local en vez de host/puerto:
# MYSQL_SOCKET=/var/run/mysqld/mysqld.sock

# Opcional si el binario no se llama "mysql":
# MYSQL_CLI=/usr/bin/mysql
# API de reservaciones y pago (mismos secretos que la pagina PHP)
RESERVATION_PORTAL_API_URL=https://villamargaritashotel.com/api/v1/reservations
RESERVATION_PORTAL_PAYMENT_BASE_URL=https://villamargaritashotel.com/pago
RESERVATION_PORTAL_API_KEY=
RESERVATION_PORTAL_SIGNING_SECRET=
PAYMENT_WEBHOOK_SECRET=
# Secreto aleatorio distinto para seudonimizar telefonos en evidencias de consentimiento.
# Genera uno con: openssl rand -hex 32
CONSENT_HASH_SECRET=
